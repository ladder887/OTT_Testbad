# Environment Configuration

# Server
PORT=3001
NODE_ENV=production
MAX_UPLOAD_FILE_SIZE_MB=2048
LOGIN_RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ott_auth
POSTGRES_USER=ott_user
POSTGRES_PASSWORD=

# JWT secrets
JWT_SECRET=
JWT_REFRESH_SECRET=

# CDN Signed Token
CDN_SHARED_SECRET=
CDN_TOKEN_TTL_SEC=1800

# Public Edge URL Mapping
EDGE_ID=edge-local
EDGE_DEFAULT_ID=edge-local
EDGE_KR_ID=edge-local
EDGE_JP_ID=edge-local
EDGE_SG_ID=edge-local
EDGE_US_ID=edge-local
EDGE_DEFAULT_URL=http://localhost:8081
EDGE_KR_URL=http://localhost:8081
EDGE_JP_URL=http://localhost:8081
EDGE_SG_URL=http://localhost:8081
EDGE_US_URL=http://localhost:8081

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Admin Emails (comma separated)
ADMIN_EMAILS=admin@ott.com
