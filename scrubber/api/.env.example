# Environment Configuration

# Server
PORT=3001
NODE_ENV=production

# CORS
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ott_auth
POSTGRES_USER=ott_user
POSTGRES_PASSWORD=ott_password_2025

# JWT Secrets (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production

# CDN Signed Token
CDN_SHARED_SECRET=your_cdn_secret_key_change_this_in_production
CDN_TOKEN_TTL_SEC=1800

# Public Edge URL Mapping
EDGE_ID=edge-local
EDGE_DEFAULT_URL=http://localhost:8081
EDGE_KR_URL=http://localhost:8081
EDGE_JP_URL=http://localhost:8081
EDGE_SG_URL=http://localhost:8081
EDGE_US_URL=http://localhost:8081

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# Neo4j
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ott_detection_2025

# Admin Emails (comma separated)
ADMIN_EMAILS=admin@ott.com
