# Copy this file to .env.lab and adjust values for your environment.

# API / Auth secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
CDN_SHARED_SECRET=
MAX_UPLOAD_FILE_SIZE_MB=2048
LOGIN_RATE_LIMIT_MAX=200
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Database
POSTGRES_DB=ott_auth
POSTGRES_USER=ott_user
POSTGRES_PASSWORD=
OTT_ADMIN_PASSWORD=
OTT_TEST_PASSWORD=

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Public edge URLs returned by playback/start
EDGE_DEFAULT_URL=http://localhost:8081
EDGE_KR_URL=http://localhost:8081
EDGE_JP_URL=http://localhost:8081
EDGE_SG_URL=http://localhost:8081
EDGE_US_URL=http://localhost:8081

# Optional logical-client collector metadata for TNSM expansion runs
ACCOUNT_KEY=user1
ACCOUNT_EMAIL=user1@test.com
LOGICAL_CLIENT_ID=lc001
PHYSICAL_HOST_ID=pi01
PHYSICAL_HOST_IP=192.168.0.131
SOURCE_IP=192.168.0.151
DEVICE_ID=dev-lc001
EDGE_ID=edge-kr
EDGE_BASE_URL=http://192.168.0.111
NETWORK_PROFILE_ID=P0

# Graph Pipeline
GRAPH_PIPELINE_STATE_FILE=/var/lib/graph-pipeline/checkpoint.json
ES_POLL_SIZE=5000
